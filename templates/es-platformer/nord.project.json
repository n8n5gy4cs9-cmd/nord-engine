{
  "format": 1,
  "name": "Platformer",
  "id": "com.crowelian.esplatformer",
  "type": "2d",
  "engineVersion": "0.1.0",
  "startScene": "scenes/main.scene.json",
  "display": {
    "width": 640,
    "height": 360,
    "scale": "fit",
    "pixelArt": true,
    "background": "#2e3440"
  },
  "physics": {
    "engine": "arcade",
    "gravity": [
      0,
      0,
      0
    ]
  },
  "input": {
    "actions": {
      "left": [
        "KeyA",
        "ArrowLeft"
      ],
      "right": [
        "KeyD",
        "ArrowRight"
      ],
      "jump": [
        "Space",
        "KeyW",
        "ArrowUp"
      ]
    }
  },
  "plugins": [
    "ui",
    "audio"
  ]
}
