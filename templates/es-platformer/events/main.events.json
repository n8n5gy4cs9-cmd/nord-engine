{
  "format": 1,
  "name": "main",
  "events": [
    {
      "type": "comment",
      "text": "Event Sheet Platformer — everything here is events + behaviors. No scripts."
    },
    {
      "type": "variable",
      "name": "coins",
      "valueType": "number",
      "value": 0
    },
    {
      "type": "variable",
      "name": "lives",
      "valueType": "number",
      "value": 3
    },
    {
      "type": "variable",
      "name": "won",
      "valueType": "number",
      "value": 0
    },
    {
      "type": "group",
      "title": "Hero animation",
      "active": true,
      "children": [
        {
          "type": "event",
          "conditions": [
            {
              "object": "Hero",
              "id": "is-jumping",
              "behavior": "Platform"
            },
            {
              "object": "Hero",
              "id": "is-falling",
              "behavior": "Platform"
            }
          ],
          "actions": [
            {
              "object": "Hero",
              "id": "set-animation",
              "params": {
                "animation": "\"jump\""
              }
            }
          ],
          "block": "or"
        },
        {
          "type": "event",
          "conditions": [
            {
              "object": "System",
              "id": "else"
            },
            {
              "object": "Hero",
              "id": "is-moving",
              "behavior": "Platform"
            }
          ],
          "actions": [
            {
              "object": "Hero",
              "id": "set-animation",
              "params": {
                "animation": "\"walk\""
              }
            }
          ]
        },
        {
          "type": "event",
          "conditions": [
            {
              "object": "System",
              "id": "else"
            }
          ],
          "actions": [
            {
              "object": "Hero",
              "id": "set-animation",
              "params": {
                "animation": "\"idle\""
              }
            }
          ]
        },
        {
          "type": "event",
          "conditions": [
            {
              "object": "System",
              "id": "every-tick"
            }
          ],
          "actions": [
            {
              "object": "Hero",
              "id": "set-mirrored",
              "params": {
                "mirrored": "Hero.Platform.Facing < 0"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "group",
      "title": "Coins",
      "active": true,
      "children": [
        {
          "type": "event",
          "conditions": [
            {
              "object": "Hero",
              "id": "is-overlapping",
              "params": {
                "object": "Coin"
              }
            }
          ],
          "actions": [
            {
              "object": "System",
              "id": "add-to-var",
              "params": {
                "variable": "coins",
                "value": "1"
              }
            },
            {
              "object": "Audio",
              "id": "play",
              "params": {
                "file": "\"assets/audio/sfx/coin.wav\"",
                "loop": "\"once\""
              }
            },
            {
              "object": "Coin",
              "id": "destroy"
            }
          ]
        }
      ]
    },
    {
      "type": "group",
      "title": "Danger",
      "active": true,
      "children": [
        {
          "type": "event",
          "conditions": [
            {
              "object": "Hero",
              "id": "is-overlapping",
              "params": {
                "object": "enemy"
              }
            },
            {
              "object": "System",
              "id": "trigger-once-while-true"
            }
          ],
          "actions": [
            {
              "object": "System",
              "id": "subtract-from-var",
              "params": {
                "variable": "lives",
                "value": "1"
              }
            },
            {
              "object": "Hero",
              "id": "set-position",
              "params": {
                "x": "48",
                "y": "314"
              }
            },
            {
              "object": "Hero",
              "id": "set-vector-y",
              "params": {
                "value": "0"
              },
              "behavior": "Platform"
            },
            {
              "object": "Hero",
              "id": "set-vector-x",
              "params": {
                "value": "0"
              },
              "behavior": "Platform"
            }
          ]
        },
        {
          "type": "event",
          "conditions": [
            {
              "object": "Hero",
              "id": "is-overlapping",
              "params": {
                "object": "Bullet"
              }
            }
          ],
          "actions": [
            {
              "object": "System",
              "id": "subtract-from-var",
              "params": {
                "variable": "lives",
                "value": "1"
              }
            },
            {
              "object": "Bullet",
              "id": "destroy"
            },
            {
              "object": "Hero",
              "id": "set-position",
              "params": {
                "x": "48",
                "y": "314"
              }
            },
            {
              "object": "Hero",
              "id": "set-vector-y",
              "params": {
                "value": "0"
              },
              "behavior": "Platform"
            },
            {
              "object": "Hero",
              "id": "set-vector-x",
              "params": {
                "value": "0"
              },
              "behavior": "Platform"
            }
          ]
        },
        {
          "type": "event",
          "conditions": [
            {
              "object": "Hero",
              "id": "compare-y",
              "params": {
                "comparison": ">",
                "value": "420"
              }
            }
          ],
          "actions": [
            {
              "object": "System",
              "id": "subtract-from-var",
              "params": {
                "variable": "lives",
                "value": "1"
              }
            },
            {
              "object": "Hero",
              "id": "set-position",
              "params": {
                "x": "48",
                "y": "314"
              }
            },
            {
              "object": "Hero",
              "id": "set-vector-y",
              "params": {
                "value": "0"
              },
              "behavior": "Platform"
            },
            {
              "object": "Hero",
              "id": "set-vector-x",
              "params": {
                "value": "0"
              },
              "behavior": "Platform"
            }
          ]
        },
        {
          "type": "event",
          "conditions": [
            {
              "object": "System",
              "id": "compare-variable",
              "params": {
                "variable": "lives",
                "comparison": "<=",
                "value": "0"
              }
            }
          ],
          "actions": [
            {
              "object": "System",
              "id": "restart-layout"
            }
          ]
        }
      ]
    },
    {
      "type": "group",
      "title": "Turret",
      "active": true,
      "children": [
        {
          "type": "event",
          "conditions": [
            {
              "object": "Turret",
              "id": "on-shoot",
              "behavior": "Turret"
            }
          ],
          "actions": [
            {
              "object": "System",
              "id": "create-object",
              "params": {
                "object": "Bullet",
                "layer": "0",
                "x": "Turret.X",
                "y": "Turret.Y"
              }
            },
            {
              "object": "Bullet",
              "id": "set-angle-of-motion",
              "params": {
                "angle": "Turret.Angle"
              },
              "behavior": "Bullet"
            }
          ]
        }
      ]
    },
    {
      "type": "group",
      "title": "Win",
      "active": true,
      "children": [
        {
          "type": "event",
          "conditions": [
            {
              "object": "Hero",
              "id": "is-overlapping",
              "params": {
                "object": "Flag"
              }
            },
            {
              "object": "System",
              "id": "compare-variable",
              "params": {
                "variable": "won",
                "comparison": "=",
                "value": "0"
              }
            }
          ],
          "actions": [
            {
              "object": "System",
              "id": "set-var",
              "params": {
                "variable": "won",
                "value": "1"
              }
            },
            {
              "object": "Message",
              "id": "set-text",
              "params": {
                "text": "\"You win!  Coins: \" & coins"
              }
            },
            {
              "object": "Hero",
              "id": "set-enabled",
              "params": {
                "state": "disabled"
              },
              "behavior": "Platform"
            }
          ]
        }
      ]
    },
    {
      "type": "event",
      "conditions": [
        {
          "object": "System",
          "id": "every-tick"
        }
      ],
      "actions": [
        {
          "object": "Hud",
          "id": "set-text",
          "params": {
            "text": "\"Coins \" & coins & \"   Lives \" & lives"
          }
        }
      ]
    }
  ]
}
