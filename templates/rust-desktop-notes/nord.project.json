{
  "format": 1,
  "name": "Rust Desktop Notes",
  "id": "com.crowelian.rustdesktopnotes",
  "type": "wasm-app",
  "engineVersion": "0.1.0",
  "startScene": "",
  "display": {
    "width": 960,
    "height": 640,
    "scale": "fit",
    "pixelArt": false,
    "background": "#2e3440"
  },
  "physics": {
    "engine": "none",
    "gravity": [
      0,
      0,
      0
    ]
  },
  "input": {
    "actions": {}
  },
  "plugins": [],
  "desktop": {
    "permissions": {
      "fs": {
        "roots": [
          "picked"
        ],
        "write": true
      },
      "dialogs": true,
      "notifications": true,
      "clipboard": "write"
    }
  }
}
