{
  "format": 1,
  "name": "Crypt of Embers",
  "id": "com.crowelian.light2d",
  "type": "2d",
  "engineVersion": "0.1.0",
  "startScene": "scenes/main.scene.json",
  "display": {
    "width": 640,
    "height": 360,
    "scale": "fit",
    "pixelArt": false,
    "background": "#05060c"
  },
  "physics": {
    "engine": "arcade",
    "gravity": [
      0,
      0,
      0
    ]
  },
  "input": {
    "actions": {
      "left": [
        "KeyA",
        "ArrowLeft"
      ],
      "right": [
        "KeyD",
        "ArrowRight"
      ],
      "up": [
        "KeyW",
        "ArrowUp"
      ],
      "down": [
        "KeyS",
        "ArrowDown"
      ],
      "jump": [
        "Space",
        "KeyW",
        "ArrowUp"
      ],
      "fire": [
        "Space",
        "Mouse0"
      ],
      "interact": [
        "KeyE",
        "Enter"
      ],
      "shadows": [
        "KeyL"
      ],
      "ambient": [
        "KeyB"
      ],
      "lab": [
        "KeyH"
      ],
      "forceDown": [
        "BracketLeft"
      ],
      "forceUp": [
        "BracketRight"
      ],
      "shadowDown": [
        "Semicolon"
      ],
      "shadowUp": [
        "Quote"
      ],
      "softDown": [
        "Comma"
      ],
      "softUp": [
        "Period"
      ],
      "c1": [
        "Digit1"
      ],
      "c2": [
        "Digit2"
      ],
      "c3": [
        "Digit3"
      ],
      "c4": [
        "Digit4"
      ],
      "c5": [
        "Digit5"
      ]
    }
  },
  "plugins": [
    "ui",
    "audio"
  ],
  "ui": {
    "skin": "cyber",
    "theme": "nord"
  }
}
