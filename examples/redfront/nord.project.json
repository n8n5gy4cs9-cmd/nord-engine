{
  "format": 1,
  "name": "Red Front 2026",
  "id": "com.crowelian.redfront",
  "type": "2d",
  "engineVersion": "0.1.0",
  "startScene": "scenes/main.scene.json",
  "display": {
    "width": 960,
    "height": 600,
    "scale": "fit",
    "pixelArt": true,
    "background": "#180808"
  },
  "physics": {
    "engine": "none",
    "gravity": [
      0,
      0,
      0
    ]
  },
  "input": {
    "actions": {
      "left": [
        "ArrowLeft"
      ],
      "right": [
        "ArrowRight"
      ],
      "up": [
        "ArrowUp"
      ],
      "down": [
        "ArrowDown"
      ],
      "confirm": [
        "Enter"
      ],
      "cancel": [
        "Escape"
      ]
    }
  },
  "plugins": [
    "ui",
    "audio"
  ],
  "ui": {
    "skin": "cyber",
    "theme": "nord"
  }
}
