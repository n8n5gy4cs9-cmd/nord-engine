{
  "format": 1,
  "name": "main",
  "events": [
    {
      "type": "comment",
      "text": "Endless runner — events only. Space / click / W jumps. Obstacles spawn on a timer and move left; hit one and press jump to retry."
    },
    {
      "type": "variable",
      "name": "score",
      "valueType": "number",
      "value": 0
    },
    {
      "type": "variable",
      "name": "over",
      "valueType": "number",
      "value": 0
    },
    {
      "type": "variable",
      "name": "speed",
      "valueType": "number",
      "value": 230
    },
    {
      "type": "group",
      "title": "Run",
      "active": true,
      "children": [
        {
          "type": "event",
          "conditions": [
            {
              "object": "System",
              "id": "every-x-seconds",
              "params": {
                "seconds": "1.3"
              }
            },
            {
              "object": "System",
              "id": "compare-variable",
              "params": {
                "variable": "over",
                "comparison": "=",
                "value": "0"
              }
            }
          ],
          "actions": [
            {
              "object": "System",
              "id": "create-object",
              "params": {
                "object": "Obstacle",
                "layer": "0",
                "x": "660",
                "y": "300"
              }
            },
            {
              "object": "Obstacle",
              "id": "set-angle-of-motion",
              "params": {
                "angle": "180"
              },
              "behavior": "Bullet"
            },
            {
              "object": "Obstacle",
              "id": "set-speed",
              "params": {
                "value": "speed"
              },
              "behavior": "Bullet"
            }
          ]
        },
        {
          "type": "event",
          "conditions": [
            {
              "object": "System",
              "id": "every-tick"
            },
            {
              "object": "System",
              "id": "compare-variable",
              "params": {
                "variable": "over",
                "comparison": "=",
                "value": "0"
              }
            }
          ],
          "actions": [
            {
              "object": "System",
              "id": "add-to-var",
              "params": {
                "variable": "score",
                "value": "dt * 10"
              }
            },
            {
              "object": "System",
              "id": "set-var",
              "params": {
                "variable": "speed",
                "value": "230 + score * 0.6"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "group",
      "title": "Crash",
      "active": true,
      "children": [
        {
          "type": "event",
          "conditions": [
            {
              "object": "Runner",
              "id": "is-overlapping",
              "params": {
                "object": "Obstacle"
              }
            },
            {
              "object": "System",
              "id": "compare-variable",
              "params": {
                "variable": "over",
                "comparison": "=",
                "value": "0"
              }
            }
          ],
          "actions": [
            {
              "object": "System",
              "id": "set-var",
              "params": {
                "variable": "over",
                "value": "1"
              }
            },
            {
              "object": "Message",
              "id": "set-text",
              "params": {
                "text": "\"CRASH!   Distance \" & floor(score) & \" m   (jump to retry)\""
              }
            },
            {
              "object": "Obstacle",
              "id": "set-speed",
              "params": {
                "value": "0"
              },
              "behavior": "Bullet"
            },
            {
              "object": "Audio",
              "id": "play",
              "params": {
                "file": "\"assets/audio/sfx/hurt.wav\"",
                "loop": "\"once\""
              }
            }
          ]
        },
        {
          "type": "event",
          "conditions": [
            {
              "object": "Input",
              "id": "on-action-pressed",
              "params": {
                "action": "jump"
              }
            },
            {
              "object": "System",
              "id": "compare-variable",
              "params": {
                "variable": "over",
                "comparison": "=",
                "value": "1"
              }
            }
          ],
          "actions": [
            {
              "object": "System",
              "id": "restart-layout"
            }
          ]
        }
      ]
    },
    {
      "type": "event",
      "conditions": [
        {
          "object": "System",
          "id": "every-tick"
        }
      ],
      "actions": [
        {
          "object": "Hud",
          "id": "set-text",
          "params": {
            "text": "\"Distance \" & floor(score) & \" m\""
          }
        }
      ]
    }
  ]
}
