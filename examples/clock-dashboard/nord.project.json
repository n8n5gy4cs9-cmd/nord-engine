{
  "format": 1,
  "name": "Clock Dashboard",
  "id": "com.crowelian.clockdashboard",
  "type": "3d",
  "engineVersion": "0.4.1",
  "startScene": "scenes/main.scene.json",
  "display": {
    "width": 1280,
    "height": 720,
    "scale": "fit",
    "pixelArt": false,
