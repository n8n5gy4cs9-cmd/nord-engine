{
  "version": 1,
  "name": "pause",
  "skin": "ui/neon.skin.json",
  "theme": {},
  "visible": false,
  "scaler": {
    "mode": "scale",
    "ref": [
      1280,
      720
    ],
    "match": 0.5
  },
  "root": {
    "type": "panel",
    "name": "root",
    "anchor": "fill",
    "style": {
      "background": "#02060fb0",
      "border": "none",
      "boxShadow": "none",
      "padding": 0
    },
    "children": [
      {
        "type": "vbox",
        "name": "card",
        "anchor": "c",
        "class": "card",
        "gap": 14,
        "style": {
          "alignItems": "center"
        },
        "children": [
          {
            "type": "label",
            "name": "t",
            "text": "PAUSED",
            "size": 44,
            "class": "title"
          },
          {
            "type": "button",
            "name": "resume",
            "text": "Resume",
            "size": 22,
            "on": {
              "pressed": "resume"
            },
            "sprites": {
              "normal": "assets/ui/button.png",
              "hover": "assets/ui/button-hover.png",
              "pressed": "assets/ui/button-pressed.png",
              "disabled": "assets/ui/button-disabled.png",
              "slice": [
                14,
                14,
                14,
                14
              ],
              "scale": 1
            },
            "style": {
              "minWidth": 220,
              "minHeight": 54,
              "color": "#e6f6ff"
            }
          },
          {
            "type": "button",
            "name": "menu",
            "text": "Main menu",
            "size": 22,
            "on": {
              "pressed": "menu"
            },
            "sprites": {
              "normal": "assets/ui/button.png",
              "hover": "assets/ui/button-hover.png",
              "pressed": "assets/ui/button-pressed.png",
              "disabled": "assets/ui/button-disabled.png",
              "slice": [
                14,
                14,
                14,
                14
              ],
              "scale": 1
            },
            "style": {
              "minWidth": 220,
              "minHeight": 54,
              "color": "#e6f6ff"
            }
          }
        ]
      }
    ]
  }
}
