{
  "format": 1,
  "name": "Vector Patrol",
  "id": "com.crowelian.vectorpatrol",
  "type": "3d",
  "engineVersion": "0.1.0",
  "startScene": "scenes/main.scene.json",
  "display": {
    "width": 960,
    "height": 540,
    "scale": "fit",
    "pixelArt": true,
    "background": "#163d57"
  },
  "physics": {
    "engine": "none",
    "gravity": [
      0,
      0,
      0
    ]
  },
  "input": {
    "actions": {
      "left": [
        "KeyA",
        "ArrowLeft"
      ],
      "right": [
        "KeyD",
        "ArrowRight"
      ],
      "up": [
        "KeyW",
        "ArrowUp"
      ],
      "down": [
        "KeyS",
        "ArrowDown"
      ],
      "fire": [
        "Space",
        "KeyJ"
      ],
      "roll": [
        "ShiftLeft",
        "ShiftRight"
      ],
      "retro": [
        "KeyC"
      ]
    }
  },
  "plugins": [
    "ui",
    "audio"
  ],
  "ui": {
    "skin": "cyber",
    "theme": "nord"
  }
}
