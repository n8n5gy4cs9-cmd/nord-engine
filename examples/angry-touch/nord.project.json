{
  "format": 1,
  "name": "Angry Touch",
  "id": "com.crowelian.angrytouch",
  "type": "wasm-game",
  "engineVersion": "0.1.0",
  "startScene": "scenes/main.scene.json",
  "display": {
    "width": 960,
    "height": 540,
    "scale": "fit",
    "pixelArt": false,
    "background": "#88c0d0"
  },
  "physics": {
    "engine": "rapier",
    "gravity": [
      0,
      980,
      0
    ]
  },
  "input": {
    "actions": {
      "left": [
        "ArrowLeft",
        "KeyA"
      ],
      "right": [
        "ArrowRight",
        "KeyD"
