      "up": [
        "ArrowUp",
        "KeyW"
      ],
      "down": [
        "ArrowDown",
        "KeyS"
      ],
      "fire": [
        "Space"
      ],
      "next": [
        "Enter"
      ],
      "restart": [
        "KeyR"
      ]
    }
