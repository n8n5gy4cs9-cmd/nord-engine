{
  "format": 1,
  "name": "Coin Rush — code workshop",
  "id": "com.crowelian.coinrush",
  "type": "2d",
  "engineVersion": "0.1.0",
  "startScene": "scenes/main.scene.json",
  "display": {
    "width": 640,
    "height": 360,
    "scale": "fit",
    "pixelArt": true,
    "background": "#2e3440"
  },
  "physics": {
    "engine": "arcade",
    "gravity": [
      0,
      900,
      0
    ]
  },
  "input": {
    "actions": {
      "left": [
        "KeyA",
        "ArrowLeft"
      ],
      "right": [
        "KeyD",
        "ArrowRight"
      ],
      "up": [
        "KeyW",
        "ArrowUp"
      ],
      "down": [
        "KeyS",
        "ArrowDown"
      ],
      "jump": [
        "Space",
        "KeyW",
        "ArrowUp"
      ],
      "fire": [
        "Space",
        "Mouse0"
      ],
      "interact": [
        "KeyE",
        "Enter"
      ],
      "dash": [
        "ShiftLeft",
        "KeyK"
      ]
    }
  },
  "plugins": [
    "ui",
    "audio"
  ],
  "ui": {
    "skin": "cyber",
    "theme": "tokyo-night"
  }
}
