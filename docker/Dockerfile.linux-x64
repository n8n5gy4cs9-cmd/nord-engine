# Builds the Linux nord-player template. Run through the editor (Project > Export templates > Build templates).
# Repo is mounted read-only at /src, the result goes to /out.
FROM rust:1-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev libxdo-dev pkg-config && rm -rf /var/lib/apt/lists/*
ENV CARGO_TARGET_DIR=/work/target
CMD cd /src && cargo build --release --locked -p nord-player --features shell && cp /work/target/release/nord-player /out/nord-player
